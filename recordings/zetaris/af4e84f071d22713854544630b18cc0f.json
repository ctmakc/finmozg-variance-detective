{
 "sql": "SELECT c.customer_name, c.channel,\n       SUM(CASE WHEN sl.period='2026-08' THEN sl.qty ELSE 0 END) AS qty_aug,\n       SUM(CASE WHEN sl.period='2026-09' THEN sl.qty ELSE 0 END) AS qty_sep,\n       SUM(CASE WHEN sl.period='2026-09' THEN sl.qty ELSE 0 END) - SUM(CASE WHEN sl.period='2026-08' THEN sl.qty ELSE 0 END) AS qty_diff\nFROM lightning.metastore.finmozg.finance_usl.sales_line sl\nJOIN lightning.metastore.finmozg.finance_usl.customer c ON sl.customer_id = c.customer_id\nWHERE sl.period IN ('2026-08','2026-09')\nGROUP BY c.customer_name, c.channel\nORDER BY qty_diff DESC",
