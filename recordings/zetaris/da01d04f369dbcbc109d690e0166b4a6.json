 "sql": "WITH sales AS (\n  SELECT period, sku, SUM(qty) AS qty_sold, SUM(revenue_cad) AS revenue\n  FROM lightning.metastore.finmozg.finance_usl.sales_line\n  WHERE period IN ('2026-08', '2026-09')\n  GROUP BY period, sku\n),\ncost AS (\n  SELECT period, sku, SUM(qty) AS qty_purch, SUM(amount_cad) AS cost\n  FROM lightning.metastore.finmozg.finance_usl.purchase_line\n  WHERE period IN ('2026-08', '2026-09')\n  GROUP BY period, sku\n)\nSELECT s.period, s.sku, s.qty_sold, s.revenue,\n       c.cost,\n       s.revenue/s.qty_sold AS avg_price,\n       c.cost/c.qty_purch AS avg_cost,\n       (s.revenue/s.qty_sold) - (c.cost/c.qty_purch) AS unit_margin\nFROM sales s\nJOIN cost c ON s.period = c.period AND s.sku = c.sku\nORDER BY s.period, s.sku",
