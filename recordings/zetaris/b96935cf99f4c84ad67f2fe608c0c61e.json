{
 "sql": "WITH purchase_agg AS (\n  SELECT\n    pl.period,\n    pl.sku,\n    SUM(pl.qty) AS po_qty,\n    SUM(pl.amount_cad) AS po_amount_cad\n  FROM lightning.metastore.finmozg.finance_usl.purchase_line pl\n  WHERE pl.period IN ('2026-08','2026-09')\n  GROUP BY pl.period, pl.sku\n),\nsales_with_cost AS (\n  SELECT\n    sl.period,\n    sl.customer_id,\n    c.customer_name,\n    c.channel,\n    sl.sku,\n    sl.qty,\n    sl.revenue_cad,\n    (sl.qty * pa.po_amount_cad / NULLIF(pa.po_qty,0)) AS cogs_cad\n  FROM lightning.metastore.finmozg.finance_usl.sales_line sl\n  JOIN lightning.metastore.finmozg.finance_usl.customer c ON sl.customer_id = c.customer_id\n  LEFT JOIN purchase_agg pa ON sl.sku = pa.sku AND sl.period = pa.period\n  WHERE sl.period IN ('2026-08','2026-09')\n)\nSELECT\n  period,\n  customer_id,\n  customer_name,\n  channel,\n  SUM(qty) AS total_qty,\n  SUM(revenue_cad) AS total_revenue,\n  SUM(cogs_cad) AS total_cogs,\n  SUM(revenue_cad - cogs_cad) AS gross_margin\nFROM sales_with_cost\nGROUP BY period, customer_id, customer_name, channel\nORDER BY period, gross_margin DESC",
