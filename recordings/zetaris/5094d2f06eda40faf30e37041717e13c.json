{
 "sql": "SELECT sku, channel,\n       MAX(CASE WHEN period='2026-08' THEN revenue_cad/qty END) AS aug_asp,\n       MAX(CASE WHEN period='2026-09' THEN revenue_cad/qty END) AS sep_asp\nFROM (\n   SELECT s.period, s.sku, c.channel, SUM(s.revenue_cad) AS revenue_cad, SUM(s.qty) AS qty\n   FROM lightning.metastore.finmozg.finance_usl.sales_line s\n   JOIN lightning.metastore.finmozg.finance_usl.customer c ON s.customer_id = c.customer_id\n   WHERE s.period IN ('2026-08','2026-09')\n   GROUP BY s.period, s.sku, c.channel\n) t\nGROUP BY sku, channel\nHAVING aug_asp IS NOT NULL AND sep_asp IS NOT NULL\nORDER BY sku, channel",
