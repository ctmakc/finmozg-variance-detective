 "sql": "SELECT sku,\n       SUM(CASE WHEN period='2026-08' THEN qty ELSE 0 END) AS qty_aug,\n       SUM(CASE WHEN period='2026-09' THEN qty ELSE 0 END) AS qty_sep,\n       SUM(CASE WHEN period='2026-09' THEN qty ELSE 0 END) - SUM(CASE WHEN period='2026-08' THEN qty ELSE 0 END) AS delta_qty\nFROM lightning.metastore.finmozg.finance_usl.purchase_line\nWHERE period IN ('2026-08','2026-09')\nGROUP BY sku\nORDER BY ABS(delta_qty) DESC\nLIMIT 20",
