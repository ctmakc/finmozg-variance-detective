{
 "sql": "SELECT sl.period, c.customer_id, c.customer_name, c.channel,\n       SUM(sl.qty) AS qty,\n       SUM(sl.revenue_cad) AS revenue,\n       SUM(sl.qty * p.wholesale_price_cad) AS wholesale_cost\nFROM lightning.metastore.finmozg.finance_usl.sales_line sl\nJOIN lightning.metastore.finmozg.finance_usl.customer c ON sl.customer_id = c.customer_id\nJOIN lightning.metastore.finmozg.finance_usl.product p ON sl.sku = p.sku\nWHERE sl.period IN ('2026-08','2026-09')\nGROUP BY sl.period, c.customer_id, c.customer_name, c.channel\nORDER BY sl.period, qty DESC",
