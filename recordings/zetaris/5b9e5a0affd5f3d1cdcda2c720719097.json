{
 "sql": "WITH slc AS (\n  SELECT\n    s.period,\n    c.channel,\n    c.customer_id,\n    c.customer_name,\n    SUM(s.qty) AS qty,\n    SUM(s.revenue_cad) AS revenue\n  FROM lightning.metastore.finmozg.finance_usl.sales_line s\n  JOIN lightning.metastore.finmozg.finance_usl.customer c ON s.customer_id = c.customer_id\n  WHERE s.period IN ('2026-08','2026-09')\n  GROUP BY s.period, c.channel, c.customer_id, c.customer_name\n),\ntotals AS (\n  SELECT\n    period,\n    SUM(qty) AS total_qty,\n    SUM(revenue) AS total_revenue\n  FROM slc\n  GROUP BY period\n)\nSELECT\n  slc.period,\n  slc.channel,\n  slc.customer_id,\n  slc.customer_name,\n  slc.qty,\n  slc.revenue,\n  slc.qty / t.total_qty AS qty_share,\n  slc.revenue / t.total_revenue AS revenue_share\nFROM slc\nJOIN totals t ON slc.period = t.period\nORDER BY slc.period, slc.channel, slc.customer_id",
