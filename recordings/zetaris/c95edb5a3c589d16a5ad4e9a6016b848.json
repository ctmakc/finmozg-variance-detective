 "sql": "SELECT s.period, s.sku, c.channel, SUM(s.revenue_cad) AS revenue_cad, SUM(s.qty) AS qty, SUM(s.revenue_cad)/SUM(s.qty) AS avg_selling_price_cad\nFROM lightning.metastore.finmozg.finance_usl.sales_line s\nJOIN lightning.metastore.finmozg.finance_usl.customer c ON s.customer_id = c.customer_id\nWHERE s.period IN ('2026-08','2026-09')\nGROUP BY s.period, s.sku, c.channel\nORDER BY s.period, s.sku, c.channel",
