{
 "sql": "SELECT s.sku,\n       c.channel,\n       SUM(CASE WHEN s.period='2026-08' THEN s.revenue_cad END) AS rev_aug,\n       SUM(CASE WHEN s.period='2026-08' THEN s.qty END) AS qty_aug,\n       SUM(CASE WHEN s.period='2026-09' THEN s.revenue_cad END) AS rev_sep,\n       SUM(CASE WHEN s.period='2026-09' THEN s.qty END) AS qty_sep,\n       SUM(CASE WHEN s.period='2026-08' THEN s.revenue_cad END)/NULLIF(SUM(CASE WHEN s.period='2026-08' THEN s.qty END),0) AS aug_asp,\n       SUM(CASE WHEN s.period='2026-09' THEN s.revenue_cad END)/NULLIF(SUM(CASE WHEN s.period='2026-09' THEN s.qty END),0) AS sep_asp\nFROM lightning.metastore.finmozg.finance_usl.sales_line s\nJOIN lightning.metastore.finmozg.finance_usl.customer c ON s.customer_id = c.customer_id\nWHERE s.period IN ('2026-08', '2026-09')\nGROUP BY s.sku, c.channel\nHAVING aug_asp IS NOT NULL AND sep_asp IS NOT NULL\nORDER BY ABS(aug_asp - sep_asp) DESC\nLIMIT 20",
