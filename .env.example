# ---------- Data: Zetaris (local Docker install) ----------
# Port 8888 is the Zetaris default; this repo's dev box maps the API to 18888 because 8888 was taken.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
# Container that reads /home/zetaris/customer-data (used by npm run zetaris:register to copy the CSV export)
ZETARIS_DRIVER_CONTAINER=zetaris-driver-1

# ---------- Power: Meterless Runtime (Nightshift) is the PRIMARY provider ----------
LLM_PROVIDER=meterless
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# Either paste the Runtime token from Nightshift's Console, or point at <stateDir>/proxy-token
METERLESS_RUNTIME_TOKEN=
METERLESS_TOKEN_FILE=
# Or paste a connect link http://<host>:<port>/connect#k=<key>
METERLESS_CONNECT_LINK=
# Routing modes (meterless/auto|fast|deep|…) or a pinned Nemotron route from GET /v1/models
METERLESS_MODEL=meterless/auto
METERLESS_MODEL_DEEP=meterless/deep
METERLESS_MODEL_FAST=meterless/fast

# ---------- Alternative providers (same code, change LLM_PROVIDER) ----------
# LLM_PROVIDER=nvidia → build.nvidia.com
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL_FAST=nvidia/nemotron-3-super-120b-a12b
# LLM_PROVIDER=openai_compat → any OpenAI-compatible endpoint, e.g. a local Ollama serving Nemotron
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_COMPAT_API_KEY=ollama
OPENAI_COMPAT_MODEL=nemotron-3-super:cloud
OPENAI_COMPAT_MODEL_FAST=nemotron-3-super:cloud

# ---------- App ----------
# true = replay recorded Zetaris results and model replies from a real live run (no network, no keys)
SAMPLE_MODE=false
PORT=8795
HMEM_DIR=.hmem
BANKFEED_PORT=8080

# ---------- Synthetic sources (docker-compose defaults) ----------
POSTGRES_USER=finmozg
POSTGRES_PASSWORD=finmozg
POSTGRES_DB=finmozg
